rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isListOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isOwnPrivateList(listId) {
      return signedIn() && listId == request.auth.uid;
    }

    function isListMember(listId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/shoppingLists/$(listId)).data.members;
    }

    function hasPendingInvite(listId) {
      return signedIn()
        && exists(/databases/$(database)/documents/invites/$(listId + "_" + request.auth.uid))
        && get(/databases/$(database)/documents/invites/$(listId + "_" + request.auth.uid)).data.status == "pending";
    }

    match /shoppingLists/{listId} {
      allow create: if signedIn()
        && listId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      allow read: if isOwnPrivateList(listId)
        || (signedIn() && request.auth.uid in resource.data.members);

      allow update, delete: if isOwnPrivateList(listId)
        || isListOwner()
        || (
          signedIn()
          && hasPendingInvite(listId)
          && !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
        );
    }

    match /shoppingLists/{listId}/items/{itemId} {
      allow read, write: if isOwnPrivateList(listId) || isListMember(listId);
    }

    function isSharedListMember(listId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/sharedLists/$(listId)).data.members;
    }

    match /sharedLists/{listId} {
      // Members and owner can read
      allow read: if signedIn() && request.auth.uid in resource.data.members;

      // Owner can create
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;

      // Owner can update/delete freely
      // Any authenticated user can add only themselves to members (invite acceptance)
      // Any member can remove only themselves (leaving the list)
      allow update: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || (
          // caller is adding only their own uid (join via invite)
          request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && !(request.auth.uid in resource.data.members)
        )
        || (
          // caller is removing only their own uid (leave)
          resource.data.members.hasAll(request.resource.data.members)
          && resource.data.members.size() == request.resource.data.members.size() + 1
          && !(request.auth.uid in request.resource.data.members)
          && request.auth.uid in resource.data.members
        )
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /sharedLists/{listId}/items/{itemId} {
      allow read, write: if isSharedListMember(listId);
    }

    match /invites/{inviteId} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }
  }
}