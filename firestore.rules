rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isListOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isListMember(listId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/shoppingLists/$(listId)).data.members;
    }

    function hasPendingInvite(listId) {
      return signedIn()
        && exists(/databases/$(database)/documents/invites/$(listId + "_" + request.auth.uid))
        && get(/databases/$(database)/documents/invites/$(listId + "_" + request.auth.uid)).data.status == "pending";
    }

    match /shoppingLists/{listId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.members;

      allow read: if signedIn() && request.auth.uid in resource.data.members;

      allow update, delete: if isListOwner()
        || (
          signedIn()
          && hasPendingInvite(listId)
          && !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
        );
    }

    match /shoppingLists/{listId}/items/{itemId} {
      allow read, write: if isListMember(listId);
    }

    match /invites/{inviteId} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /notifications/{notificationId} {
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow update: if signedIn() && resource.data.toUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId;
    }
  }
}